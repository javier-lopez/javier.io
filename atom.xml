---
layout: nil
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">

 <title>{{ site.title | default: site.author | xml_escape }}</title>
 <subtitle>{{ site.description | xml_escape }}</subtitle>
 <link href="{{ '/atom.xml' | absolute_url }}" rel="self"/>
 <link href="{{ '/' | absolute_url }}"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ '/' | absolute_url }}</id>
 <author>
   <name>{{ site.author | xml_escape }}</name>
   {% if site.url %}<uri>{{ site.url }}</uri>{% endif %}
 </author>
 <generator uri="https://jekyllrb.com">Jekyll</generator>

 {% for post in site.posts %}
 <entry>
   <title>{{ post.title | xml_escape }}</title>
   <link href="{{ post.url | absolute_url }}"/>
   <published>{{ post.date | date_to_xmlschema }}</published>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>{{ post.id | absolute_url }}</id>
   <author>
     <name>{{ site.author | xml_escape }}</name>
   </author>
   {% if post.tags %}
   {% for tag in post.tags %}
   <category term="{{ tag | xml_escape }}"/>
   {% endfor %}
   {% endif %}
   {% if post.excerpt %}
   <summary type="html">{{ post.excerpt | strip_html | normalize_whitespace | truncate: 300 | xml_escape }}</summary>
   {% endif %}
   <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
